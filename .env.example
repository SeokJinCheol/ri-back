RAG_APP_NAME="Real Iron RAG API"
RAG_ENVIRONMENT=local
RAG_DEBUG=false

# Ollama embedding provider (ollama pull embeddinggemma)
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING_MODEL=embeddinggemma
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_TIMEOUT_SECONDS=120
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_MAX_UPLOAD_BYTES=10485760
RAG_MAX_DOCUMENT_CHARS=1000000
RAG_CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","null"]
# RAG_DOCUMENT_DB_PATH=D:/workspace/real_iron/ri-back/data/documents.sqlite3

# Default provider: ollama or openai (Documents can override per upload)
RAG_EMBEDDING_PROVIDER=ollama
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Server only. OPENAI_API_KEY is also supported; RAG_OPENAI_API_KEY takes precedence.
RAG_OPENAI_API_KEY=
